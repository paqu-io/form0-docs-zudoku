{
  "name": "form0-docs-zudoku",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "zudoku dev",
    "build": "zudoku build",
    "format": "prettier --write src scripts .github/workflows package.json zudoku.config.jsx",
    "format:check": "prettier --check src scripts .github/workflows package.json zudoku.config.jsx",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "lint": "npm run lint:advisory",
    "lint:advisory": "eslint .",
    "lint:gate": "eslint . --quiet",
    "lint:check": "npm run lint:gate",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "preview": "zudoku preview",
    "postinstall": "node scripts/apply-zudoku-locale-patch.js",
    "check": "npm run format:check && npm run i18n:validate && npm run lint:gate && npm run build"
  },
  "dependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "zudoku": "^0.66.6"
  }
}
