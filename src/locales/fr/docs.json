  "diagrams": {
    "evaluationCycle": {
      "ariaLabel": "Une modification de valeur exécute une passe eval complète dans un ordre fixe : calculs, caractère obligatoire, visibilité, lecture seule, erreurs de valeur. Le renderer déclenche ensuite un événement change. Son gestionnaire renvoie des opérations que le host applique, et un SETVALUE relance la passe sans déclencher d'autre événement change.",
      "caption": "Une modification exécute une seule passe ordonnée. Les gestionnaires d'événements ne modifient jamais directement le formulaire : ils renvoient des opérations, que le host applique.",
      "userEdits": "Saisie",
      "onePass": "une passe complète, toujours dans le même ordre",
      "calculations": "Calculs",
      "required": "Obligatoire",
      "visible": "Visible",
      "readOnly": "Lecture seule",
      "valueErrorsLine1": "Erreurs",
      "valueErrorsLine2": "de valeur",
      "state": "état",
      "renderer": "Renderer",
      "rerenders": "réaffiche les champs",
      "handlerRuns": "le gestionnaire s'exécute",
      "returns": "renvoie",
      "operations": "Opérations",
      "toHost": "au host",
      "hostApplies": "Le host applique",
      "loopTitle": "SETVALUE → nouvel eval",
      "loopNote": "pas de second événement change"
    },
    "calculationOrder": {
      "ariaLabel": "Les champs calculés s'exécutent après les champs qu'ils référencent : subtotal utilise qty et price et s'exécute en premier, tax utilise subtotal et s'exécute en deuxième, total utilise subtotal et tax et s'exécute en troisième. Les champs a et b se référencent mutuellement : ils sont donc mis à null et une erreur est signalée ; le champ c référence a et s'exécute avec une entrée null.",
      "caption": "L'ordre dans le schéma n'a pas d'importance : chaque champ calculé s'exécute après les champs qu'il référence. Les champs d'un cycle sont mis à null, et tout le reste s'exécute quand même.",
      "orderTitle": "Exécution par ordre de dépendance",
      "cycleTitle": "Un cycle est ignoré",
      "input": "champ de saisie",
      "runsFirst": "exécuté en 1er",
      "runsSecond": "exécuté en 2e",
      "runsThird": "exécuté en 3e",
      "cycleResult": "mis à null + erreur",
      "runsWithNull": "exécuté avec null"
    },
    "repeatableScope": {
      "ariaLabel": "Le formulaire principal contient les champs customer et discount_pct. Une RepeatableSection appelée line_items contient deux lignes, et chaque ligne exécute sa propre instance du moteur avec les champs qty, price et line_total. Les valeurs du formulaire principal sont copiées dans chaque ligne : line_total peut donc utiliser discount_pct. Les deux lignes ne se voient pas.",
      "caption": "Chaque ligne est évaluée par son propre moteur avec une copie des valeurs du parent. Les lignes ne lisent jamais les valeurs des autres lignes.",
      "mainForm": "Formulaire principal",
      "row1": "Ligne 1",
      "row2": "Ligne 2",
      "ownEngine": "instance de moteur propre",
      "sameFields": "mêmes champs, valeurs distinctes",
      "parentCopied": "valeurs du parent copiées dans la ligne",
      "isolated": "lignes isolées"
    }
  }
